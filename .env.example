PORT=3000
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call the API.
# Supports exact entries and wildcards such as https://*.up.railway.app.
ALLOWED_ORIGINS=https://dholera-frontend-production.up.railway.app,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# Use a long random value in production.
SESSION_SECRET=replace-me

# Optional: set the frontend site URL so the backend can automatically
# include it in the CORS allowlist. Useful when deployments set the
# frontend URL but don't modify `ALLOWED_ORIGINS` directly.
# Example:
# VITE_SITE_URL=https://dholera-frontend-production.up.railway.app
