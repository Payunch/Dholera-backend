PORT=3000
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call the API.
# Supports exact entries and wildcards such as https://*.up.railway.app.
ALLOWED_ORIGINS=https://dholera-frontend-production.up.railway.app,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# Use a long random value in production.
SESSION_SECRET=replace-me
JWT_SECRET=replace-me-too
ADMIN_USER=admin
ADMIN_PASS=change-me

# Optional: set the frontend site URL so the backend can automatically
# include it in the CORS allowlist. Useful when deployments set the
# frontend URL but don't modify `ALLOWED_ORIGINS` directly.
# Example:
# VITE_SITE_URL=https://dholera-frontend-production.up.railway.app

# ──────────────────────────────────────────────────────────────────────────────
# Cloudinary — PDF Cloud Storage
# Sign up free at https://cloudinary.com (Free tier: 25 GB storage, 25 GB/mo bandwidth)
# Get your credentials from: Dashboard → Settings → API Keys
# ──────────────────────────────────────────────────────────────────────────────
# Option A: Single DSN (recommended)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Option B: Individual variables
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Optional folders used by the backend integration
# CLOUDINARY_IMAGE_FOLDER=dholera/images
# CLOUDINARY_PDF_FOLDER=dholera/pdfs

# ──────────────────────────────────────────────────────────────────────────────
# Email OTP (NodeMailer / Gmail SMTP)
# ──────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Dholera Growth Platform" <your-email@gmail.com>

# Optional database override for production.
# Defaults to sqlite when unset.
# DB_DIALECT=mysql
# DB_HOST=127.0.0.1
# DB_NAME=dholera
# DB_USER=root
# DB_PASS=
# DB_SSL=false
