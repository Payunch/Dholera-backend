PORT=3000
# Local development default. Set NODE_ENV=production in Railway.
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call the API.
# Supports exact entries and wildcards such as https://*.up.railway.app.
ALLOWED_ORIGINS=https://dholeraplatform.com,https://www.dholeraplatform.com,https://dholerafrontend.onrender.com,http://localhost:5173

# Use a long random value in production.
SESSION_SECRET=replace-me
JWT_SECRET=replace-me-too
ADMIN_USER=admin
ADMIN_PASS=change-me

RAZORPAY_KEY_ID=rzp_test_SrFoSeJ7k4FtTA
RAZORPAY_KEY_SECRET=3Cb0OdEx5gkgr3LCCugm2U0V
# Razorpay payment gateway credentials used for PDF purchases.
# These must be set in the Railway/production environment.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxx

# Optional: set the frontend site URL so the backend can automatically
# include it in the CORS allowlist. Useful when deployments set the
# frontend URL but don't modify `ALLOWED_ORIGINS` directly.
# Example:
# VITE_SITE_URL=https://dholeraplatform.com

# ──────────────────────────────────────────────────────────────────────────────
# Cloudinary — PDF Cloud Storage
# Sign up free at https://cloudinary.com (Free tier: 25 GB storage, 25 GB/mo bandwidth)
# Get your credentials from: Dashboard → Settings → API Keys
# ──────────────────────────────────────────────────────────────────────────────
# Option A: Single DSN (recommended)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Option B: Individual variables
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Optional folders used by the backend integration
# CLOUDINARY_IMAGE_FOLDER=dholera/images
# CLOUDINARY_PDF_FOLDER=dholera/pdfs

# ──────────────────────────────────────────────────────────────────────────────
# Email OTP (NodeMailer / Gmail SMTP)
# ──────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Dholera Growth Platform" <your-email@gmail.com>

# Set to true to bypass email verification if SMTP is failing.
# When enabled, use test code 123456 to verify.
BYPASS_EMAIL_VERIFICATION=false

# Optional auth throttling / setup window tuning (milliseconds)
# PASSCODE_SETUP_TTL_MS=600000
# PASSCODE_LOGIN_WINDOW_MS=900000
# PASSCODE_LOGIN_MAX=10

# Optional database override for production.
# Defaults to sqlite when unset.
# DB_DIALECT=mysql
# DB_HOST=127.0.0.1
# DB_NAME=dholera
# DB_USER=root
# DB_PASS=
# DB_SSL=false
