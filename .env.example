PORT=3000
# Local development default. Set NODE_ENV=production in Railway.
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call the API.
# Supports exact entries and wildcards such as https://*.up.railway.app.
ALLOWED_ORIGINS=https://dholeraplatform.com,https://www.dholeraplatform.com,https://dholerafrontend.onrender.com,http://localhost:5173

# Use a long random value in production.
SESSION_SECRET=replace-me
JWT_SECRET=replace-me-too
ADMIN_USER=admin
ADMIN_PASS=change-me

# Gemini AI API Key (required for auto-blog generation and image generation)
GEMINI_API_KEY=your_api_key_here
# Auto-blog cost controls: one candidate, no AI image-ranking by default.
AUTO_BLOG_MAX_CANDIDATES=1
AUTO_BLOG_USE_VISION_SELECTION=false
# Optional: set this to the least expensive supported text model in your Gemini account.
# GEMINI_TEXT_MODEL=gemini-2.5-flash-lite

# PhonePe payment gateway credentials
PHONEPE_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=sandbox
## PhonePe will redirect the browser after payment to this URL. For local dev
## we recommend the backend landing endpoint which posts back to the opener
## and then forwards to the frontend. Use the `:merchantTransactionId` placeholder.
## Example (backend running on 3001):
PHONEPE_REDIRECT_URL=http://localhost:3001/api/payment/landing/:merchantTransactionId
## PhonePe webhook (server-to-server callback)
PHONEPE_WEBHOOK_URL=http://localhost:3001/api/payment/webhook

# Optional: set the frontend site URL so the backend can automatically
# include it in the CORS allowlist. Useful when deployments set the
# frontend URL but don't modify `ALLOWED_ORIGINS` directly.
# Example:
# VITE_SITE_URL=https://dholeraplatform.com

# ──────────────────────────────────────────────────────────────────────────────
# Cloudinary — PDF Cloud Storage
# Sign up free at https://cloudinary.com (Free tier: 25 GB storage, 25 GB/mo bandwidth)
# Get your credentials from: Dashboard → Settings → API Keys
# ──────────────────────────────────────────────────────────────────────────────
# Option A: Single DSN (recommended)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Option B: Individual variables
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Optional folders used by the backend integration
# CLOUDINARY_IMAGE_FOLDER=dholera/images
# CLOUDINARY_PDF_FOLDER=dholera/pdfs

# ──────────────────────────────────────────────────────────────────────────────
# Email OTP (NodeMailer / Gmail SMTP)
# ──────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Dholera Growth Platform" <your-email@gmail.com>

# Set to true to bypass email verification if SMTP is failing.
# When enabled, use test code 123456 to verify.
BYPASS_EMAIL_VERIFICATION=false

# Optional auth throttling / setup window tuning (milliseconds)
# PASSCODE_SETUP_TTL_MS=600000
# PASSCODE_LOGIN_WINDOW_MS=900000
# PASSCODE_LOGIN_MAX=10

# Optional database override for production.
# Defaults to sqlite when unset.
# DB_DIALECT=mysql
# DB_HOST=127.0.0.1
# DB_NAME=dholera
# DB_USER=root
# DB_PASS=
# DB_SSL=false

# WordPress REST API Credentials
WP_URL=https://your-wordpress-site.com
WP_USERNAME=your_username
WP_APP_PASSWORD=your_app_password
